{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/aim-facts.mjs\"",
            "timeout": 20,
            "statusMessage": "bearing: corpus を読んでいる"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "auto",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/precompact.mjs\"",
            "timeout": 10,
            "statusMessage": "bearing: 閾値 —— 圧縮する代わりに引き継ぐ"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/boot-ritual.mjs\"",
            "timeout": 10,
            "statusMessage": "bearing: 未処理の baton がある"
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/corpus-delta.mjs\"",
            "timeout": 15,
            "statusMessage": "bearing: corpus が動いた"
          }
        ]
      }
    ]
  }
}
