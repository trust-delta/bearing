#!/usr/bin/env bash
# main への直プッシュを、code を含むときに止める。
#
# 規則（operator, 2026-09-01）: 非コードのドキュメント系は直プッシュ可、コードを含む場合は
# PR 必須。⚠ **GitHub 側でこれを条件付きで強制することはできない**（実測 2026-09-01:
# path 条件で push を弾ける push ruleset は "Source public repos cannot have push rules" と
# "only org-owned repos can have push rules" の 2 つの理由で拒否される）∴ 強制の実体は
# ここ（行為の瞬間）と CI の guard（着地後に赤くする）の 2 段である。
#
# ⚠ **この hook は破れる**（`--no-verify`）。それは欠陥ではなく設計である —— 規則を曲げる
# 判断は operator のものであり、道具がそれを奪ってはならない。**破った事実は CI guard に
# 残る**ので、沈黙して通ることはない。
#
# 設置（clone ごとに 1 度。core.hooksPath は git config であって clone に付いてこない）:
#
#   git config core.hooksPath .githooks
#
# ⚠ **設置されていない clone では、この hook は存在しないのと同じである。** その場合に
# 規則を守っているのは CI guard だけになる。

set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
classifier="$repo_root/scripts/classify-paths.mjs"

# 判定器が無ければ、黙って通さない。⚠ 観測できないことを「問題なし」と読まない。
if [ ! -f "$classifier" ]; then
  echo "pre-push: 判定器が無い（$classifier）。" >&2
  echo "⚠ 規則を検査できなかった。clean ではなく「不在」である —— 意図した push なら --no-verify。" >&2
  exit 1
fi

if ! command -v node >/dev/null 2>&1; then
  echo "pre-push: node が無い ∴ 規則を検査できなかった。" >&2
  echo "⚠ clean ではなく「不在」である —— 意図した push なら --no-verify。" >&2
  exit 1
fi

# stdin: <local ref> <local sha> <remote ref> <remote sha>
zero='0000000000000000000000000000000000000000'
status=0

while read -r _local_ref local_sha remote_ref remote_sha; do
  # main 以外への push は、この規則の対象ではない。
  case "$remote_ref" in
    refs/heads/main) ;;
    *) continue ;;
  esac

  # branch の削除は path を持たない。
  [ "$local_sha" = "$zero" ] && continue

  if [ "$remote_sha" = "$zero" ]; then
    # remote にまだ main が無い。範囲を決められない ∴ 全 file を見る。
    changed="$(git diff --name-only "$(git hash-object -t tree /dev/null)" "$local_sha")"
  else
    changed="$(git diff --name-only "$remote_sha" "$local_sha")"
  fi

  [ -z "$changed" ] && continue

  echo ""
  echo "── pre-push: main への直プッシュを検査している ──────────────────────────"
  if ! printf '%s\n' "$changed" | node "$classifier"; then
    status=1
  fi
done

if [ "$status" -ne 0 ]; then
  cat >&2 <<'MSG'

──────────────────────────────────────────────────────────────────────────────
push を止めた。code を含む変更は PR 経由で入れる規則である。

  git switch -c <branch>
  git push -u origin <branch>
  gh pr create

⚠ 規則を曲げる判断は operator のものである。意図した直プッシュなら:

  git push --no-verify

  ただし CI の guard がそれを検出し、main の上に赤く残す。**それは故障ではなく、
  規則が破られた事実の記録である。**
──────────────────────────────────────────────────────────────────────────────
MSG
  exit 1
fi

exit 0
